# Argentic API key (aek_...). Make one at https://getargentic.com/platform -> Keys. Required.
ARGENTIC_API_KEY=

# Your model provider's key. Optional here: visitors can paste their own in the page
# (bring your own key), and it is sent on each request and never stored.
# The default model is a free NVIDIA one; get a key at https://build.nvidia.com (starts with nvapi-).
MODEL_KEY=

# Optional: another model. Prices are dollars per million tokens.
# ARGENTIC_MODEL_PROVIDER=
# ARGENTIC_MODEL_ID=
# ARGENTIC_PRICE_IN=0
# ARGENTIC_PRICE_OUT=0

# Optional: keeps each visitor's run and sandbox inbox between requests on Vercel.
# Add the Upstash Redis integration and these fill in by themselves (KV_REST_API_URL and KV_REST_API_TOKEN also work).
# Without it the template keeps state in the server's temp folder, which is fine locally but
# can vanish between requests on Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: seconds each tool pretends to work, so there is time to press Kill. Default 2.5.
# ACTION_DELAY_MS=2500

# Optional: point at another Argentic API or dashboard.
# ARGENTIC_BASE_URL=
# ARGENTIC_DASHBOARD_URL=https://getargentic.com
