{
  "mcpServers": {
    "argentic": {
      "type": "http",
      "url": "${user_config.base_url}/mcp",
      "headers": {
        "Authorization": "Bearer ${user_config.api_key}",
        "X-Model-Key": "${user_config.model_key}"
      }
    },
    "argentic-platform": {
      "type": "http",
      "url": "https://argentic-labs.vercel.app/mcp"
    }
  }
}
